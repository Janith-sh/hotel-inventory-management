# MongoDB Connection String
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database-name

# JWT Secret Key
JWT_SECRET=your-super-secret-jwt-key

# Frontend URL(s) (for CORS)
# Example for Azure Static Web Apps:
# FRONTEND_URL should be your live frontend origin, no trailing slash
FRONTEND_URL=https://white-glacier-0887e3010.1.azurestaticapps.net
# Optional: allow an additional origin (e.g., staging)
# FRONTEND_URL_2=https://staging.example.com

# Node Environment
NODE_ENV=production